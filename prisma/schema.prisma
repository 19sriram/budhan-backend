generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
}

model Session {
  id     String @id
  userId BigInt
  token  String

    @@unique([userId, token]) 
  @@map("sessions")
}